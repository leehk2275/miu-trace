[Unit]
Description=Refresh MIU Trace Dropbox and Google Sheets indexes
After=network-online.target

[Service]
Type=oneshot
User=miutrace
Group=miutrace
WorkingDirectory=/opt/miu-trace
EnvironmentFile=/etc/miu-trace.env
Environment=PYTHONPATH=/opt/miu-trace
ExecStart=/opt/miu-trace/.venv/bin/python scripts/sync_dropbox_beta.py
ExecStart=/opt/miu-trace/.venv/bin/python scripts/sync_google_beta.py
ExecStart=/opt/miu-trace/.venv/bin/python scripts/sync_miu_hub.py
ExecStart=/opt/miu-trace/.venv/bin/python scripts/archive_events.py
ExecStart=/opt/miu-trace/.venv/bin/python scripts/export_pages_snapshot.py
ExecStart=/opt/miu-trace/.venv/bin/python scripts/publish_pages_data.py
ReadWritePaths=/opt/miu-trace/.git /opt/miu-trace/frontend/data /opt/miu-trace/var
